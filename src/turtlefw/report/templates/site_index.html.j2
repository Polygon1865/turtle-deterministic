<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Turtle Daily · A 股与港股确定性研究日报">
  <title>Turtle Daily · {{ day }}</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f3f0e8;
      --paper: #fbf8f1;
      --panel: #f7f2e8;
      --fg: #1f1d18;
      --muted: #6d665a;
      --line: #d8cfbf;
      --soft: #e9e1d2;
      --accent: #b4552f;
      --accent-soft: #f2dfd4;
      --ok: #3d6b4f;
      --ok-soft: #e5efe7;
      --warn: #8a5a1f;
      --warn-soft: #f4e8d5;
      --bad: #9e3b31;
      --bad-soft: #f5e2df;
      --shadow: none;
      --radius: 8px;
      --mono: "SFMono-Regular", "Cascadia Code", "JetBrains Mono", Consolas, monospace;
      --serif: "Iowan Old Style", "Palatino Linotype", Georgia, "Songti SC", serif;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #161411;
        --paper: #1e1b17;
        --panel: #242019;
        --fg: #f0ebdf;
        --muted: #a49b8b;
        --line: #3a342a;
        --soft: #2a251e;
        --accent: #e39f7c;
        --accent-soft: #3a261d;
        --ok: #8fc9a4;
        --ok-soft: #1d3025;
        --warn: #efb477;
        --warn-soft: #362619;
        --bad: #ee9a8f;
        --bad-soft: #3a211e;
      }
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--fg);
      font: 14px/1.65 ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", "Noto Sans SC", sans-serif;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; text-underline-offset: 3px; }
    code, .num { font-family: var(--mono); font-variant-numeric: tabular-nums; }
    .topbar {
      max-width: 1200px; margin: 0 auto; padding: 18px 24px 14px;
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
      border-bottom: 1px solid var(--line);
    }
    .brand { display: flex; align-items: center; gap: 10px; font: 700 12px/1.2 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
    .brand-mark {
      width: 26px; height: 26px; border-radius: 4px;
      display: grid; place-items: center;
      background: var(--fg); color: var(--paper); font: 700 13px/1 var(--mono);
    }
    .topbar nav { display: flex; gap: 16px; flex-wrap: wrap; font: 11px/1.4 var(--mono); letter-spacing: .04em; color: var(--muted); }
    .tabrail { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .date-tabs {
      display: flex; gap: 6px; overflow-x: auto; scrollbar-width: thin; padding: 12px 0 0;
    }
    .date-tabs a, .market-tabs button {
      flex: 0 0 auto; padding: 6px 10px; border: 1px solid var(--line);
      border-radius: 4px; color: var(--muted); font: 11px/1.4 var(--mono);
      background: transparent; cursor: pointer;
    }
    .date-tabs a.active { color: var(--paper); background: var(--fg); border-color: var(--fg); font-weight: 700; }
    .date-tabs a:hover, .market-tabs button:hover { text-decoration: none; border-color: var(--accent); color: var(--accent); }
    .market-tabs { display: flex; gap: 6px; flex-wrap: wrap; padding: 8px 0 16px; border-bottom: 1px solid var(--line); }
    .market-tabs button.active { color: var(--paper); background: var(--accent); border-color: var(--accent); }
    .market-tabs button span { opacity: .7; margin-left: 3px; }
    .market-chip {
      display: inline-flex; align-items: center; border-radius: 3px; padding: 1px 5px;
      margin-left: 5px; font: 700 9px/1.6 var(--mono); letter-spacing: .06em;
      color: var(--accent); background: var(--accent-soft); vertical-align: 1px;
    }
    .market-chip.hk { color: var(--warn); background: var(--warn-soft); }
    main { max-width: 1200px; margin: 0 auto; padding: 28px 24px 72px; }
    .hero {
      display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(300px, .8fr);
      gap: 28px; align-items: end; padding: 30px 0 28px; border-bottom: 1px solid var(--line);
    }
    .eyebrow { margin: 0 0 10px; color: var(--muted); font: 11px/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
    h1 { margin: 0; font-family: var(--serif); font-size: clamp(36px, 5vw, 60px); font-weight: 600; line-height: 1.02; letter-spacing: -.045em; }
    .lede { max-width: 58ch; margin: 16px 0 0; color: var(--muted); font-size: 15px; }
    .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .stat { background: var(--paper); border: 1px solid var(--line); border-radius: 6px; padding: 12px 14px; }
    .stat b { display: block; font: 600 25px/1.1 var(--mono); letter-spacing: -.04em; }
    .stat span { color: var(--muted); font: 10px/1.5 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
    section { margin-top: 36px; }
    .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
    h2 { margin: 0; font-family: var(--serif); font-size: 22px; font-weight: 600; letter-spacing: -.02em; }
    .section-note { color: var(--muted); font: 10px/1.5 var(--mono); letter-spacing: .04em; text-align: right; }
    .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
    .card {
      display: block; background: var(--paper); border: 1px solid var(--line);
      border-radius: var(--radius); padding: 16px; color: inherit; min-height: 200px;
    }
    a.card:hover { text-decoration: none; border-color: var(--accent); }
    .card-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .rank { color: var(--muted); font: 11px/1.4 var(--mono); letter-spacing: .06em; }
    .badge {
      display: inline-flex; align-items: center; border-radius: 3px;
      padding: 2px 6px; font: 700 9px/1.6 var(--mono); letter-spacing: .07em;
      border: 1px solid transparent; white-space: nowrap;
    }
    .status-ok { color: var(--ok); background: var(--ok-soft); border-color: color-mix(in srgb, var(--ok) 25%, transparent); }
    .status-warn { color: var(--warn); background: var(--warn-soft); border-color: color-mix(in srgb, var(--warn) 25%, transparent); }
    .status-bad { color: var(--bad); background: var(--bad-soft); border-color: color-mix(in srgb, var(--bad) 25%, transparent); }
    .card h3 { margin: 13px 0 2px; font-family: var(--serif); font-size: 21px; font-weight: 600; letter-spacing: -.03em; }
    .ticker { color: var(--muted); font-size: 11px; }
    .thesis { margin: 11px 0 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
    .card dl { display: flex; gap: 16px; margin: 14px 0 0; }
    .card dt { color: var(--muted); font: 9px/1.4 var(--mono); letter-spacing: .05em; text-transform: uppercase; }
    .card dd { margin: 2px 0 0; font: 600 13px/1.4 var(--mono); }
    .table-wrap { overflow: auto; background: var(--paper); border: 1px solid var(--line); border-radius: 6px; }
    table { width: 100%; border-collapse: collapse; min-width: 760px; }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: middle; }
    th { color: var(--muted); font: 700 9px/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; background: var(--soft); position: sticky; top: 0; z-index: 1; }
    tbody tr:hover { background: color-mix(in srgb, var(--accent) 4%, transparent); }
    tr:last-child td { border-bottom: 0; }
    .report-name { font-weight: 650; }
    .muted { color: var(--muted); }
    .empty { padding: 26px; color: var(--muted); text-align: center; font-size: 13px; }
    .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 10px; }
    .toolbar input, .toolbar select {
      height: 32px; border: 1px solid var(--line); border-radius: 4px;
      background: var(--paper); color: var(--fg); padding: 0 9px; font: 12px/1 var(--mono);
    }
    .toolbar input { width: min(260px, 100%); }
    .toolbar label { display: inline-flex; gap: 5px; align-items: center; color: var(--muted); font: 11px/1.4 var(--mono); }
    .toolbar .count { margin-left: auto; color: var(--muted); font: 11px/1.4 var(--mono); }
    .verdict { font-size: 11px; color: var(--muted); }
    .verdict.failed { color: var(--bad); }
    footer { margin-top: 36px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font: 10px/1.5 var(--mono); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    [hidden] { display: none !important; }
    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; gap: 18px; }
      .cards { grid-template-columns: 1fr; }
      .card { min-height: 0; }
      .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }
    @media (max-width: 640px) {
      .topbar, main, .tabrail { padding-left: 14px; padding-right: 14px; }
      .topbar nav { display: none; }
      .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      th, td { padding: 9px 10px; }
      .hide-mobile { display: none; }
    }
    @media print {
      .toolbar, .topbar nav, .market-tabs { display: none; }
      body { background: #fff; }
    }
  </style></style>
</head>
<body>
<header class="topbar">
  <div class="brand"><span class="brand-mark">T</span><span>Turtle Daily</span></div>
  <nav>
    <a href="{{ ranking_href }}">候选 CSV</a>
    <a href="{{ deep_href }}">深度 CSV</a>
    <a href="{{ health_href }}">健康检查</a>
  </nav>
</header>
<div class="tabrail">
<div class="date-tabs" aria-label="按日期切换">
  {% for tab in tabs %}
  <a href="{{ tab.href }}" class="{{ 'active' if tab.active else '' }}"{% if tab.active %} aria-current="page"{% endif %}>{{ tab.date }}</a>
  {% endfor %}
</div>
<div class="market-tabs" role="tablist" aria-label="按市场切换">
  <button type="button" class="active" data-market-tab="ALL" role="tab" aria-selected="true">全部 <span>{{ total }}</span></button>
  <button type="button" data-market-tab="A" role="tab" aria-selected="false">A 股 <span>{{ a_count }}</span></button>
  <button type="button" data-market-tab="HK" role="tab" aria-selected="false">港股 <span>{{ hk_count }}</span></button>
</div>
</div>

<main>
  <section class="hero">
    <div>
      <p class="eyebrow">{{ day }}{% if trade_date %} · 数据日 {{ trade_date }}{% endif %}</p>
      <h1>{% if day == (tabs|first).date %}今日研究终端{% else %}{{ day }} 研究存档{% endif %}</h1>
      <p class="lede">A 股候选池 + 港股全市场筛选，逐票生成确定性报告；港股按研究预算优先进入 LLM。</p>
    </div>
    <div class="stats">
      <div class="stat"><b>{{ candidate_count }}</b><span>候选池</span></div>
      <div class="stat"><b>{{ total }}</b><span>当日报告</span></div>
      <div class="stat"><b class="status-ok">{{ passed }}</b><span>通过</span></div>
      <div class="stat"><b class="{{ 'status-bad' if failed else 'status-ok' }}">{{ failed }}</b><span>失败</span></div>
    </div>
  </section>

  {% if top_reports %}
  <section id="top-picks">
    <div class="section-head">
      <h2>今日优先看</h2>
      <span class="section-note">按深度排名取前 3</span>
    </div>
    <div class="cards">
      {% for r in top_reports %}
      {% if r.report_href %}
      <a class="card" data-market-card="{{ r.market or 'A' }}" href="{{ r.report_href }}">
      {% else %}
      <article class="card" data-market-card="{{ r.market or 'A' }}">
      {% endif %}
        <div class="card-top">
          <span class="rank">#{{ r.market_rank or r.rank or loop.index }}</span>
          {% if r.status == 'failed' %}
          <span class="badge status-bad" title="{{ r.error }}">FAILED</span>
          {% else %}
          <span class="badge {{ 'status-ok' if r.qa == 'PASS' else ('status-warn' if r.qa == 'WARN' else 'status-bad') }}">{{ r.qa }}</span>
          {% endif %}
        </div>
        <h3>{{ r.name or r.code }}</h3>
        <div class="ticker"><code>{{ r.code }}</code><span class="market-chip {{ 'hk' if r.market == 'HK' else '' }}">{{ r.market or 'A' }}</span>{% if r.industry %} · {{ r.industry }}{% endif %}</div>
        <p class="thesis">
          {% if r.thesis %}{{ r.thesis }}{% elif r.research == 'on' %}LLM 研究已完成，正文见报告。{% else %}确定性报告；未启用 LLM 研究。{% endif %}
        </p>
        <dl>
          <div><dt>安全边际</dt><dd>{{ r.margin or '—' }}</dd></div>
          <div><dt>综合底价</dt><dd>{{ r.floor or '—' }}</dd></div>
          <div><dt>当前溢价</dt><dd>{{ r.premium or '—' }}</dd></div>
        </dl>
      {% if r.report_href %}
      </a>
      {% else %}
      </article>
      {% endif %}
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section id="reports">
    <div class="section-head">
      <h2 id="reports-title">今日 {{ total }} 份报告</h2>
      <span class="section-note">QA 逐票校验 · 数字来自确定性链路</span>
    </div>
    {% if reports %}
    <div class="table-wrap">
      <table id="report-table">
        <thead>
          <tr><th>#</th><th>标的</th><th>市场</th><th class="hide-mobile">行业</th><th>QA</th><th class="hide-mobile">研究</th><th>覆盖率</th><th class="hide-mobile">安全边际</th><th>报告</th></tr>
        </thead>
        <tbody>
        {% for r in reports %}
          <tr data-market="{{ r.market or 'A' }}">
            <td class="num">{{ r.market_rank or r.rank or loop.index }}</td>
            <td><span class="report-name">{{ r.name or r.code }}</span><br><code>{{ r.code }}</code></td>
            <td><span class="market-chip {{ 'hk' if r.market == 'HK' else '' }}">{{ r.market or 'A' }}</span></td>
            <td class="hide-mobile">{{ r.industry or '—' }}</td>
            <td>{% if r.status == 'failed' %}<span class="badge status-bad" title="{{ r.error }}">FAILED</span>{% else %}<span class="badge {{ 'status-ok' if r.qa == 'PASS' else ('status-warn' if r.qa == 'WARN' else 'status-bad') }}">{{ r.qa }}</span>{% endif %}</td>
            <td class="hide-mobile">{{ 'LLM' if r.research == 'on' else '确定性' }}</td>
            <td class="num">{{ r.numeric_coverage or '—' }}</td>
            <td class="num hide-mobile">{{ r.margin or '—' }}</td>
            <td>{% if r.report_href %}<a href="{{ r.report_href }}">打开</a>{% else %}<span class="muted">—</span>{% endif %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="table-wrap"><div class="empty">今天没有可发布的报告。</div></div>
    {% endif %}
  </section>

  <section id="candidates">
    <div class="section-head">
      <h2>候选池 {{ candidate_count }}</h2>
      <span class="section-note">A 股快速筛选 {{ a_candidate_count }} · 港股全市场筛选 {{ hk_candidate_count }}</span>
    </div>
    {% if candidates %}
    <div class="toolbar">
      <input id="candidate-search" type="search" placeholder="搜索代码或名称" aria-label="搜索候选">
      <select id="channel-filter" aria-label="按通道筛选">
        <option value="">全部通道</option>
        {% for channel in candidates|map(attribute='channel')|unique %}
        <option value="{{ channel }}">{{ channel or '未标注' }}</option>
        {% endfor %}
      </select>
      <label><input id="deep-only" type="checkbox"> 只看深度</label>
      <select id="candidate-sort" aria-label="排序">
        <option value="rank">按排名</option>
        <option value="margin">按安全边际</option>
      </select>
      <span class="count" id="candidate-count">{{ candidate_count }} / {{ candidate_count }}</span>
    </div>
    <div class="table-wrap">
      <table id="candidate-table">
        <thead>
          <tr><th>#</th><th>标的</th><th>市场</th><th class="hide-mobile">通道</th><th>ROE</th><th>PE</th><th class="hide-mobile">PB</th><th>R%</th><th>GG%</th><th>安全边际</th><th>结论</th></tr>
        </thead>
        <tbody>
        {% for c in candidates %}
          <tr data-rank="{{ c.rank }}" data-market="{{ c.market }}" data-search="{{ (c.code ~ ' ' ~ c.name)|lower }}" data-channel="{{ c.channel }}" data-deep="{{ '1' if c.deep else '0' }}" data-margin="{{ c.margin }}" title="得分 {{ c.score or '—' }} · 成交额 {{ c.turnover or '—' }}">
            <td class="num">{{ c.market_rank or c.rank }}</td>
            <td><span class="report-name">{{ c.name or '—' }}</span><br><code>{{ c.code }}</code></td>
            <td><span class="market-chip {{ 'hk' if c.market == 'HK' else 'a' }}">{{ c.market }}</span></td>
            <td class="hide-mobile">{{ c.channel or '—' }}</td>
            <td class="num">{{ c.roe or '—' }}</td>
            <td class="num">{{ c.pe or '—' }}</td>
            <td class="num hide-mobile">{{ c.pb or '—' }}</td>
            <td class="num">{{ c.r or '—' }}</td>
            <td class="num">{{ c.gg or '—' }}</td>
            <td class="num">{{ c.margin or '—' }}</td>
            <td class="verdict {{ 'failed' if '失败' in c.verdict else '' }}">{{ c.verdict or ('深度分析' if c.deep else '未深度') }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="table-wrap"><div class="empty">今天没有候选 CSV；可能只跑了指定代码。</div></div>
    {% endif %}
  </section>

  <footer>
    <span>生成于 {{ generated_at }} · {{ day }}</span>
    <span><a href="{{ ranking_href }}">ranking.csv</a> · <a href="{{ deep_href }}">ranking_deep.csv</a>{% if ranking_hk_href %} · <a href="{{ ranking_hk_href }}">ranking_hk.csv</a>{% endif %} · <a href="{{ health_href }}">health.txt</a></span>
  </footer>
</main>

<script>
(function () {
  var tabs = Array.prototype.slice.call(document.querySelectorAll("[data-market-tab]"));
  var reportRows = Array.prototype.slice.call(document.querySelectorAll("#report-table tbody tr"));
  var cards = Array.prototype.slice.call(document.querySelectorAll("[data-market-card]"));
  var reportsTitle = document.getElementById("reports-title");
  var topSection = document.getElementById("top-picks");
  var currentMarket = "ALL";

  function setMarket(market) {
    currentMarket = market;
    tabs.forEach(function (tab) {
      var active = tab.dataset.marketTab === market;
      tab.classList.toggle("active", active);
      tab.setAttribute("aria-selected", active ? "true" : "false");
    });
    var visible = 0;
    reportRows.forEach(function (row) {
      var show = market === "ALL" || row.dataset.market === market;
      row.hidden = !show;
      if (show) visible += 1;
    });
    cards.forEach(function (card) {
      card.hidden = market !== "ALL" && card.dataset.marketCard !== market;
    });
    if (topSection) {
      var anyCard = market === "ALL" || cards.some(function (card) {
        return card.dataset.marketCard === market;
      });
      topSection.hidden = !anyCard;
    }
    if (reportsTitle) {
      var label = market === "ALL" ? "" : (market === "A" ? "A 股 " : "港股 ");
      reportsTitle.textContent = "今日 " + label + visible + " 份报告";
    }
    if (market !== "ALL" && channel) {
      channel.value = "";
      if (deepOnly) deepOnly.checked = false;
    }
    if (search && channel && deepOnly && count) apply();
  }

  tabs.forEach(function (tab) {
    tab.addEventListener("click", function () { setMarket(tab.dataset.marketTab); });
  });
  var initial = new URLSearchParams(window.location.search).get("market");
  setMarket(initial === "A" || initial === "HK" ? initial : "ALL");

  var table = document.getElementById("candidate-table");
  if (!table) return;
  var rows = Array.prototype.slice.call(table.tBodies[0].rows);
  var search = document.getElementById("candidate-search");
  var channel = document.getElementById("channel-filter");
  var deepOnly = document.getElementById("deep-only");
  var sort = document.getElementById("candidate-sort");
  var count = document.getElementById("candidate-count");

  function apply() {
    var query = (search.value || "").trim().toLowerCase();
    var selected = channel.value;
    var onlyDeep = deepOnly.checked;
    var visible = 0;
    rows.forEach(function (row) {
      var ok = (currentMarket === "ALL" || row.dataset.market === currentMarket) &&
        (!query || row.dataset.search.indexOf(query) !== -1) &&
        (!selected || row.dataset.channel === selected) &&
        (!onlyDeep || row.dataset.deep === "1");
      row.hidden = !ok;
      if (ok) visible += 1;
    });
    count.textContent = visible + " / " + rows.length;
  }

  function reorder() {
    var byMargin = sort.value === "margin";
    rows.sort(function (a, b) {
      if (byMargin) {
        var am = parseFloat(a.dataset.margin);
        var bm = parseFloat(b.dataset.margin);
        if (isNaN(am)) am = -Infinity;
        if (isNaN(bm)) bm = -Infinity;
        return bm - am;
      }
      return Number(a.dataset.rank) - Number(b.dataset.rank);
    });
    var body = table.tBodies[0];
    rows.forEach(function (row) { body.appendChild(row); });
    apply();
  }

  search.addEventListener("input", apply);
  channel.addEventListener("change", apply);
  deepOnly.addEventListener("change", apply);
  sort.addEventListener("change", reorder);
  apply();
})();
</script>
</body>
</html>
