<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Turtle Daily · {{ day }}</title>
  <style>
    :root { color-scheme: light dark; --bg: #f5f6f8; --fg: #172033; --muted: #667085; --line: #d9dee8; --card: #fff; --ok: #067647; --warn: #b54708; --bad: #b42318; }
    @media (prefers-color-scheme: dark) { :root { --bg: #101828; --fg: #ecf0f5; --muted: #98a2b3; --line: #344054; --card: #182230; } }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif; }
    main { max-width: 1100px; margin: 0 auto; padding: 40px 20px 72px; }
    h1 { margin: 0 0 6px; font-size: 30px; letter-spacing: -0.02em; }
    .sub { color: var(--muted); margin: 0 0 28px; }
    .stats { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 22px; }
    .pill { background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; font-size: 13px; }
    .pill b { font-variant-numeric: tabular-nums; }
    .status-ok { color: var(--ok); } .status-warn { color: var(--warn); } .status-bad { color: var(--bad); }
    table { width: 100%; border-collapse: collapse; background: var(--card); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    th, td { text-align: left; padding: 13px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
    th { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
    tr:last-child td { border-bottom: 0; }
    a { color: #175cd3; text-decoration: none; }
    a:hover { text-decoration: underline; }
    code { font-size: 12px; color: var(--muted); }
    .muted { color: var(--muted); }
    footer { margin-top: 22px; color: var(--muted); font-size: 12px; }
    @media (max-width: 720px) { th:nth-child(5), td:nth-child(5) { display: none; } }
  </style>
</head>
<body>
<main>
  <h1>Turtle Daily</h1>
  <p class="sub">A 股 deterministic-first 日报 · {{ day }}</p>
  <div class="stats">
    <span class="pill">报告 <b>{{ total }}</b></span>
    <span class="pill">QA 通过 <b class="status-ok">{{ passed }}</b></span>
    <span class="pill">QA 失败 <b class="status-bad">{{ failed }}</b></span>
    <span class="pill">整体 <b class="{{ 'status-ok' if ok else 'status-bad' }}">{{ 'PASS' if ok else 'ATTENTION' }}</b></span>
  </div>
  <table>
    <thead>
      <tr><th>#</th><th>代码</th><th>名称</th><th>QA</th><th>研究</th><th>覆盖率</th><th>报告</th></tr>
    </thead>
    <tbody>
    {% for r in reports %}
      <tr>
        <td>{{ r.rank or loop.index }}</td>
        <td><code>{{ r.code }}</code></td>
        <td>{{ r.name or '—' }}</td>
        <td class="{{ 'status-ok' if r.qa == 'PASS' else ('status-warn' if r.qa == 'WARN' else 'status-bad') }}">{{ r.qa }}</td>
        <td>{{ {'on': 'LLM', 'fallback': '回退确定性', 'attempted': '尝试中', 'off': '确定性'}.get(r.research, r.research) }}</td>
        <td>{{ r.numeric_coverage or '—' }}</td>
        <td>{% if r.report_href %}<a href="{{ r.report_href }}">打开</a>{% else %}<span class="muted">—</span>{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <footer>Generated {{ generated_at }} · <a href="health.txt">health.txt</a></footer>
</main>
</body>
</html>
